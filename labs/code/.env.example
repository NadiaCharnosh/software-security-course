# Скопіюйте у .env та вкажіть свій номер варіанта (номер у списку групи, 1–30).
VARIANT=1

# Група та ПІБ використовуються лише для підпису згенерованих артефактів.
STUDENT_GROUP=ІП-31
STUDENT_NAME=Прізвище Ім'я

# Порт вразливого застосунку (публікується ЛИШЕ на 127.0.0.1).
VULNAPP_PORT=8080

# Секрет вразливого застосунку. НАВМИСНО СЛАБКИЙ — це частина завдання ЛР5.
VULNAPP_SECRET=dev-secret
